# Secrets: never commit real configuration
.env
.env.*
!.env.example

# Local data produced by the demo
data/*.db
data/*.db-wal
data/*.db-shm
data/golden/*.json

# ...except the vector index, which is a build input rather than local data.
#
# The production Dockerfile COPYs it, retrieval loads it, and its hash is
# pinned. Excluding it meant `docker build` could not work from a clean
# checkout -- and the only way to regenerate it, scripts/build_vector_index.py,
# calls a real embedding API. So leaving it out would have forced CI to either
# fail or make live provider calls, which is exactly what the live gate exists
# to prevent. 176 KB, deterministic, and verified by corpus fingerprint at load.
!data/kb_vectors.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.venv-*/
venv/

# uv's resolver lock. Not the source of truth here: CI and the images install
# from pyproject extras and the hashed `requirements-api.txt`, and a second lock
# nobody installs from only drifts.
uv.lock

# Node is used only to drive the visual checks in tests/visual/; its packages
# are reinstalled from package-lock.json, never committed.
node_modules/

# Visual-check output: screenshots and reports are evidence for one run, not
# source. Written under tests/visual/artifacts/ by the script, and ignored at
# the root in case a tool drops one there.
tests/visual/artifacts/
playwright-report/
test-results/
/*.png

# Superseded ad-hoc validation scripts (replaced by tests/visual/) and an empty
# scratch file. Listed so they can never be committed if they linger locally.
/playwright_validate.js
/playwright_validate.ps1
/temp_venv.txt

# TLS material. The local development certificate is generated on demand by
# scripts/gen_tls_secret.sh and applied straight to the cluster; the private key
# has no reason to exist in a working tree, let alone in history. Listed by
# extension rather than by path so a key dropped anywhere is still ignored.
*.key
*.pem
*.crt
*.csr
*.p12
*.pfx
certs/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local tooling config (editor/agent launch profiles)
.claude/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
