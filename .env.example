# Copy to .env and fill in. .env is git-ignored; never commit real values.
#
# The platform runs without any of these. With no GEMINI_API_KEY it starts in
# demo mode using a deterministic stub provider, and says so in the UI, the CLI
# and every trace.

# --- LLM provider -----------------------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
# Read from the environment only. Never hardcoded, never logged, never sent in
# a prompt, and stripped by value from traces and error messages.
#
# A key SELECTS the real provider. It does not AUTHORISE using it -- see the
# note on AGENT_PLATFORM_LIVE at the end of this file. Those were the same fact
# until it cost 72 unintended calls.
GEMINI_API_KEY=

# Any model from the rate card in src/agent_platform/cost/pricing.py.
# Default is gemini-3.5-flash-lite: free tier, low latency, and well suited to
# the short schema-constrained decisions this platform actually makes.
# Upgrade path for harder routing: gemini-3.7-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Thinking tokens per call. 0 disables, -1 is automatic.
# Disabled by default for correctness, not cost: thinking tokens count as
# output, so on a thinking model they compete with GEMINI_MAX_OUTPUT_TOKENS and
# can consume the whole budget, returning empty text with finish_reason
# MAX_TOKENS.
GEMINI_THINKING_BUDGET=0
GEMINI_MAX_OUTPUT_TOKENS=2048

# --- Storage ----------------------------------------------------------------
DATABASE_PATH=data/agent_platform.db

# --- Reliability ------------------------------------------------------------
# The values below are the code's own defaults. Copying this file must not
# loosen anything: RECURSION_LIMIT was tightened from 25 to 15, and an example
# that still said 25 quietly undid that for anyone who ran `cp .env.example .env`.
MAX_RETRIES=2
RECURSION_LIMIT=15
LLM_TIMEOUT=30
TOOL_TIMEOUT=10

# --- Rate limiting, per caller ------------------------------------------------
# Per caller (API principal, dashboard visitor), and shared across replicas when
# REDIS_URL is set. 60/minute is the default: 10 stopped the demonstration
# mid-tour for a single reader clicking through it.
REQUESTS_PER_MINUTE=60
REQUESTS_PER_HOUR=100

# --- Cost governance (USD) --------------------------------------------------
# Checked before every model call, not only before tool calls.
DAILY_BUDGET=1.00
MAX_REQUEST_COST=0.05

# --- Limits -----------------------------------------------------------------
MAX_INPUT_CHARS=8000
MAX_CONTEXT_ITEMS=20
MAX_TRACE_PAYLOAD_CHARS=500

# The rest are optional and shown at their defaults, commented out. Every one
# is a ceiling; none can be set to zero to switch it off.
#
# Longest question the platform accepts, everywhere (dashboard, CLI, API).
# MAX_QUESTION_CHARS=100
# Total characters of gathered context handed to the model in one request.
# MAX_CONTEXT_TOTAL_CHARS=65536
# Per-request resource ceilings.
# MAX_LLM_CALLS_PER_REQUEST=12
# MAX_TOOL_CALLS_PER_REQUEST=8
# REQUEST_DEADLINE_SECONDS=180
# MAX_TOOL_OUTPUT_BYTES=32768
# Suspended actions the deployment holds, and how long one waits for a human.
# MAX_PENDING_CONFIRMATIONS=50
# CONFIRMATION_TTL_SECONDS=900
# Provider circuit breaker: consecutive failures to open, seconds to stay open.
# CIRCUIT_FAILURE_THRESHOLD=5
# CIRCUIT_COOLDOWN_SECONDS=60
# Persisted vector index for hybrid retrieval. Default: data/kb_vectors.db.
# KB_VECTOR_INDEX_PATH=
#
# HTTP API process only (`python -m agent_platform.api`).
# API_HOST=127.0.0.1
# API_PORT=8000
# LOG_FORMAT=json

# --- Environment ------------------------------------------------------------
ENVIRONMENT=demo
LOG_LEVEL=INFO

# Shared state. Leave empty for process-local state, which is the default and
# what a single-process deployment wants. Set it and pending confirmations, the
# provider-call ledger, the rate-limiter window and the graph checkpointer move
# to Redis, so several replicas share them. Needs Redis 8 or Redis Stack.
# See docs/state.md.
REDIS_URL=

# Where tools run. `inprocess` (default) calls handlers directly. `mcp` puts a
# real MCP server in its own process between the gateway and the tools, so the
# execution boundary is a process boundary and every call must carry a signed
# grant. stdio transport only in this version. See docs/execution-boundary.md.
TOOL_TRANSPORT=inprocess

# HMAC key for execution grants. Required by TOOL_TRANSPORT=mcp, unused by
# inprocess. Minimum 16 bytes. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
EXECUTION_GRANT_SECRET=

# Durable storage. Empty means the SQLite file at DATABASE_PATH, which is the
# default. Set it and requests, events and recorded spend move to PostgreSQL,
# shared by every replica -- which is what makes the daily budget mean one
# number instead of one per pod. See docs/state.md.
DATABASE_URL=

# --- API authentication -----------------------------------------------------
# Required by the HTTP API. With no credentials configured the API REFUSES TO
# START rather than serving open -- the same rule an unreachable REDIS_URL
# follows. A control that switches itself off when its configuration is missing
# is off on the day it matters, and nothing in the logs says so.
#
# The value below is a placeholder and is deliberately INVALID: the fourth
# field must be a sha256 digest, and "REPLACE_ME" is not one, so it is refused
# at start-up instead of quietly becoming a working credential.
#
# Mint a real one -- the token is printed once and is not stored anywhere:
#
#   agent-platform auth new-key --principal ops-oncall --scope confirm:write
#   agent-platform auth new-key --principal ingest-svc --scope runs:write
#
# Then paste the configuration line it prints. Format, one per line:
#
#   <key id>  <principal>  <scopes>  <sha256 of the secret>
#
# Scopes are independent and none implies another. `runs:write` submits,
# `confirm:write` approves, `metrics:read` scrapes. Separating who may ask for
# a high-risk action from who may approve it is the point; there is no `admin`
# scope, and an identity that genuinely needs two carries two.
#
# Multi-line values need quoting in a .env file:
#   API_AUTH_KEYS="line one
#   line two"
API_AUTH_KEYS="0000000a placeholder runs:write REPLACE_ME_WITH_A_REAL_SHA256_DIGEST"

# The same table read from a file instead. Preferred in Kubernetes, where it is
# a Secret mounted read-only: environment variables are readable through
# /proc/<pid>/environ, land in crash dumps, and are inherited by child
# processes -- and this platform spawns one when TOOL_TRANSPORT=mcp.
# Setting BOTH this and API_AUTH_KEYS refuses to start: ambiguous configuration
# about credentials is the kind that resolves wrongly in silence.
API_AUTH_KEYS_FILE=

# `enforced` (default) or `disabled`. Running the HTTP API without
# authentication has to be typed out; it can never be reached by omission.
API_AUTH_MODE=enforced

# Deployment-wide rate ceiling, across every caller. REQUESTS_PER_MINUTE above
# is what ONE caller may do; this is what the deployment will absorb in total.
# They are different controls and only looked like one number while there was
# one caller -- setting them equal would mean one caller could still fill the
# shared bucket and deny everybody, which is the denial-of-service that
# per-caller quota exists to close. Empty derives it as 10x the per-caller
# limit. See docs/api.md.
GLOBAL_REQUESTS_PER_MINUTE=
GLOBAL_REQUESTS_PER_HOUR=

# How many suspended actions ONE caller may hold awaiting approval.
#
# The same pairing as the two lines above, and for the same reason.
# MAX_PENDING_CONFIRMATIONS is capacity -- how many the deployment will hold.
# This is fairness -- how much of that capacity one caller may take. Capacity
# alone made the store first-come-first-served, and a red-team pass showed what
# that costs: one visitor, inside their own rate limit, took every slot in six
# minutes, and every other visitor's high-risk action was then refused before a
# human ever saw it. Refusing rather than evicting meant nothing was lost, but
# availability of the approval step is exactly what was removed.
#
# Empty derives a share of the global cap (an eighth, never below two), which
# is 6 with the default of 50. A value above the global cap is clamped to it.
MAX_PENDING_CONFIRMATIONS_PER_KEY=

# --- Railway, dashboard service only -----------------------------------------
# Nothing to set for the image: `railway.toml` names it with
# `build.dockerfilePath = "Dockerfile.dashboard"`, so the repository alone
# decides that the dashboard, not the API at the root `Dockerfile`, is built.
# (The RAILWAY_DOCKERFILE_PATH service variable would do the same from outside
# the repository; it is no longer needed.) See docs/deploy.md.
#
# PORT is injected by Railway and must not be set by hand. The image's CMD reads
# it and binds 0.0.0.0; overriding either is how a service becomes unreachable.

# --- Per-visitor quota, dashboard only ---------------------------------------
# The dashboard charges each visitor their own bucket instead of putting every
# reader in the global one. The bucket name is a salted digest of the client
# address Railway's edge reports in X-Real-IP; the raw address is never stored,
# logged, traced or rendered.
#
# There is no proxy-hop setting, and that is deliberate. The dashboard is
# deployed on Railway, whose edge writes X-Real-IP, and that single header is
# the only one read. X-Forwarded-For is ignored entirely -- reading a chain
# correctly means knowing how many proxies are in front, and a count nobody
# re-checks is a control that fails quietly in the unsafe direction.
#
# Putting the dashboard behind a different proxy means revisiting that trust
# boundary in dashboard/app.py, not setting a variable here.
#
# VISITOR_ID_SALT makes the digest an anonymisation rather than a lookup: an
# unsalted hash of an IPv4 address is reversible with a table of four billion
# entries. Leave it empty here -- it is a secret and belongs in the host's
# secret store, not in a versioned file. Unset, the app generates one per
# process, which stays anonymous but restarts everybody's window on a redeploy,
# so a real deployment should set it.
VISITOR_ID_SALT=

# --- Live provider authorisation --------------------------------------------
# Deliberately absent from this file, and it must stay absent from yours.
#
# AGENT_PLATFORM_LIVE authorises real provider calls. It is checked in
# build_provider(), below pytest and shared by the CLI, the dashboard and the
# vector-index builder, so nothing that selects tests can reach around it.
#
# It is NOT read from .env, and setting it here would not work. That is the
# point: a value that can arrive from a dotfile becomes ambient, which is
# exactly how possessing an API key came to mean permission to spend it. Supply
# it for the one command that should spend quota and let it disappear again:
#
#   AGENT_PLATFORM_LIVE=<value> pytest -m live
#
# The accepted value is an exact phrase, documented in
# docs/live-verification.md. Booleans -- 1, true, yes -- are refused on purpose:
# those are the values that turn up by accident in CI matrices and shell
# profiles. Never put it in CI, a shell profile, a script, or this file.
